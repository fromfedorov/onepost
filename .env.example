# Echo configuration. Copy to .env and fill in values.

# Application
APP_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite+aiosqlite:///./data/echo.db

# Encryption key for OAuth tokens. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do NOT change after tokens are stored — they will be unreadable.
ECHO_ENCRYPTION_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/oauth/linkedin/callback
